PORT=8081
SECRET_KEY=change-me-in-production
# Llave para cifrar el secreto de la verificación en dos pasos (opcional; si falta se deriva de SECRET_KEY).
# Si la cambias, quien tenga 2FA activo tendrá que volver a activarlo.
MFA_ENCRYPTION_KEY=
DATABASE_NAME=timber
DATABASE_URI=mongodb://127.0.0.1:27017
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8081
NODE_ENV=development

# Correo (invitaciones, recuperar contraseña, facturas)
# Opción A — Resend (recomendado): https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Mi Tiendita <onboarding@mitiendita.software>

# Opción B — Gmail (contraseña de aplicación, no la normal)
# SMTP_SERVICE=gmail
# SMTP_USER=tu@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# MAIL_FROM=Mi Tiendita <tu@gmail.com>

# Opción C — SMTP genérico
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Mercado Pago — suscripciones (Access Token de Credenciales)
# Sandbox: TEST-...  |  Producción: APP_USR-...
# https://www.mercadopago.com.mx/developers/panel/app
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks → «Clave secreta»). Obligatoria en producción:
# sin ella el webhook responde 401 a todo.
MP_WEBHOOK_SECRET=
MP_CURRENCY=MXN

# Terminal de cobro Mercado Pago Point (cada tienda conecta SU cuenta por OAuth)
# Crea una aplicación en https://www.mercadopago.com.mx/developers/panel/app → "Punto de venta / Point":
#   - Redirect URL:   {API_PUBLIC_URL}/point/oauth/callback   (igual a MP_OAUTH_REDIRECT)
#   - Webhooks → evento "Order (Mercado Pago)": {API_PUBLIC_URL}/point/webhook  (usa la misma MP_WEBHOOK_SECRET)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT=http://localhost:8081/point/oauth/callback
# Firma el parámetro state del OAuth. Genera uno:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=
# Cifra los tokens de cada tienda (AES-256-GCM), 32 bytes en hex (64 caracteres). Mismo comando de arriba.
# Si lo cambias, las tiendas tienen que volver a conectar su cuenta.
TOKEN_ENC_KEY=
# URL del front (regreso tras pagar) y del API (webhook). En local el sync no necesita ngrok.
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8081

# Inventario Mágico — Gemini Flash-Lite
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Estimado en pesos por cada uso de Inventario Mágico (el cargo real está en Google)
AI_COST_MXN_PER_USE=0.15

# Platform admin seed
PLATFORM_ADMIN_EMAIL=platform@timber.com
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=Platform123!
